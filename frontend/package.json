{
    "name": "musigree",
    "description": "Social Graphing for the Discogs Database",
    "private": true,
    "version": "1.0.83",
    "type": "module",
    "author": {
        "name": "Andy Radburn",
        "url": "http://andyradburn.co.uk"
    },
    "contributors": [
        {
            "name": "Josiah Wolf Oberholtzer",
            "url": "http://josiahwolfoberholtzer.com"
        }
    ],
    "homepage": "http://musigree.com",
    "license": "MIT",
    "readme": "../README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/aradburn/musigree.git"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "dev": "vite",
        "dev-debug": "vite --debug",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint source --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint source --fix",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "check-types": "tsc --noEmit",
        "check-updates": "npx npm-check-updates",
        "refresh-baseline-browser-mapping": "npm i --save-dev baseline-browser-mapping@latest"
    },
    "dependencies": {
        "@reactour/tour": "^3.8.0",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "d3": "^7.9.0",
        "debounce": "^3.0.0",
        "dompurify": "^3.4.12",
        "file-saver": "^2.0.5",
        "htmlparser2": "^12.0.0",
        "react": "^19.2.7",
        "react-arborist": "^3.13.2",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^19.2.7",
        "text-case": "^1.2.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.61.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/bootstrap": "^5.2.11",
        "@types/d3": "^7.4.3",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-istanbul": "^4.1.10",
        "baseline-browser-mapping": "^2.10.43",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-testing-library": "^7.16.2",
        "globals": "^16.3.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "brace-expansion@1": "1.1.16"
    },
    "engines": {
        "node": ">=26.1.0"
    }
}
