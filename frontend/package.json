{
    "name": "musigree",
    "description": "Social Graphing for the Discogs Database",
    "private": true,
    "version": "1.0.45",
    "type": "module",
    "author": {
        "name": "Andy Radburn",
        "url": "http://andyradburn.co.uk"
    },
    "contributors": [
        {
            "name": "Josiah Wolf Oberholtzer",
            "url": "http://josiahwolfoberholtzer.com"
        }
    ],
    "homepage": "http://musigree.com",
    "license": "MIT",
    "readme": "../README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/aradburn/musigree.git"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "dev": "vite",
        "dev-debug": "vite --debug",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint source --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint source --ext ts,tsx --fix",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "check-types": "tsc --noEmit",
        "check-updates": "npx npm-check-updates",
        "refresh-baseline-browser-mapping": "npm i --save-dev baseline-browser-mapping@latest"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "d3": "^7.9.0",
        "debounce": "3.0.0",
        "dompurify": "3.3.0",
        "file-saver": "^2.0.5",
        "htmlparser2": "10.0.0",
        "react": "^19.2.0",
        "react-arborist": "^3.4.3",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^19.2.0",
        "text-case": "1.2.9"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/bootstrap": "^5.2.10",
        "@types/d3": "^7.4.3",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-istanbul": "^4.0.14",
        "baseline-browser-mapping": "^2.8.32",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-refresh": "^0.4.24",
        "eslint-plugin-testing-library": "^7.13.5",
        "jsdom": "^27.2.0",
        "prettier": "^3.7.3",
        "sass": "^1.94.2",
        "typescript": "^5.9.3",
        "vite": "^7.2.6",
        "vite-plugin-remove-console": "^2.2.0",
        "vitest": "^4.0.14"
    }
}
